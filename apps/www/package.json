{
  "name": "@strata/www",
  "version": "0.0.0",
  "private": true,
  "description": "The official Strata website, built with AnalogJS and Angular.",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudflare": "BUILD_PRESET=cloudflare-pages vite build",
    "preview": "node dist/analog/server/index.mjs",
    "preview:cloudflare": "pnpm run build:cloudflare && wrangler pages dev dist/analog/public --port 8789",
    "pages:create": "wrangler pages project create strata-www --production-branch main",
    "deploy:cloudflare": "pnpm run build:cloudflare && wrangler pages deploy dist/analog/public --project-name=strata-www --branch=main",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@analogjs/content": "^2.7.2",
    "@analogjs/router": "^2.7.2",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@strata/analog": "workspace:*",
    "@strata/core": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@voltui/components": "1.0.1",
    "angular-movement": "0.8.0",
    "front-matter": "4.0.2",
    "lumen-icons": "0.2.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.7.2",
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@angular/build": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@playwright/test": "1.62.1",
    "@testing-library/angular": "19.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "jsdom": "28.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.1",
    "wrangler": "4.135.0"
  }
}
