{
  "name": "@strata-sc/relay",
  "version": "0.0.0",
  "private": true,
  "description": "A real-world operations console used to dogfood Strata in an Analog application.",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "node dist/analog/server/index.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:server-components": "node --experimental-strip-types ../../tools/server-components/relay.ts"
  },
  "dependencies": {
    "@analogjs/content": "^2.7.2",
    "@analogjs/router": "^2.7.2",
    "@angular/cdk": "22.1.7",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.0.0",
    "@strata-sc/analog": "workspace:*",
    "@strata-sc/core": "workspace:*",
    "@strata-sc/server-components": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@voltui/components": "1.0.1",
    "lumen-icons": "0.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.8.0",
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular/build": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@playwright/test": "1.63.0",
    "h3": "^1.15.11",
    "nitropack": "^2.13.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
