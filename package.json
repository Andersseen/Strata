{
  "name": "strata",
  "private": true,
  "version": "0.0.0",
  "description": "Server Components and structured server APIs for Angular and Analog.",
  "homepage": "https://strata-www.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/Strata.git"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/Strata/issues"
  },
  "keywords": [
    "angular",
    "analogjs",
    "h3",
    "nitro",
    "server-components",
    "typescript",
    "server-framework"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "www:dev": "pnpm --filter @strata-sc/www dev",
    "www:build": "turbo run build --filter=@strata-sc/www",
    "www:build:cloudflare": "turbo run build:cloudflare --filter=@strata-sc/www",
    "www:pages:dev": "pnpm www:build:cloudflare && pnpm --filter @strata-sc/www exec wrangler pages dev dist/analog/public --port 8789",
    "www:pages:create": "pnpm --filter @strata-sc/www pages:create",
    "www:pages:deploy": "pnpm www:build:cloudflare && pnpm --filter @strata-sc/www exec wrangler pages deploy dist/analog/public --project-name=strata-www --branch=main",
    "www:test": "pnpm --filter @strata-sc/www test",
    "www:test:e2e": "pnpm --filter @strata-sc/www test:e2e",
    "relay:dev": "pnpm --filter @strata-sc/relay dev",
    "relay:build": "pnpm --filter @strata-sc/relay build",
    "relay:test": "pnpm --filter @strata-sc/relay test",
    "relay:test:e2e": "pnpm --filter @strata-sc/relay test:e2e",
    "relay:verify:server-components": "pnpm --filter @strata-sc/relay verify:server-components",
    "test": "turbo run test && pnpm test:release && pnpm test:performance-tools",
    "test:release": "vitest run --config tools/release/vitest.config.ts",
    "test:performance-tools": "vitest run --config tools/performance/vitest.config.ts",
    "test:full-stack-performance": "node --experimental-strip-types tools/performance/full-stack.ts",
    "test:full-stack-performance:compare": "node --experimental-strip-types tools/performance/compare.ts",
    "test:consumer": "node --experimental-strip-types tools/consumer/run.ts",
    "test:consumer:types": "node --experimental-strip-types tools/consumer/type-closure/run.ts",
    "test:analog": "node --experimental-strip-types tools/analog/run.ts",
    "test:analog-streaming": "node --experimental-strip-types tools/analog/streaming.ts",
    "test:analog-headers": "node --experimental-strip-types tools/analog/headers.ts",
    "test:analog-forms": "node --experimental-strip-types tools/analog/forms.ts",
    "test:analog-observability": "node --experimental-strip-types tools/analog/observability.ts",
    "test:server-components": "node --experimental-strip-types tools/server-components/run.ts",
    "test:server-component-navigation": "node --experimental-strip-types tools/server-components/navigation.ts",
    "test:server-component-defer": "node --experimental-strip-types tools/server-components/defer.ts",
    "test:server-component-server-only": "node --experimental-strip-types tools/server-components/server-only.ts",
    "test:server-component-security": "node --experimental-strip-types tools/server-components/security.ts",
    "test:server-component-request-context": "node --experimental-strip-types tools/server-components/request-context.ts",
    "test:server-component-authorization": "node --experimental-strip-types tools/server-components/authorization.ts",
    "test:server-component-failures": "node --experimental-strip-types tools/server-components/failures.ts",
    "test:server-component-ssr-response": "node --experimental-strip-types tools/server-components/ssr-response.ts",
    "test:server-component-dev": "node --experimental-strip-types tools/server-components/dev.ts",
    "test:full-stack-package-consumer": "node --experimental-strip-types tools/server-components/full-stack-consumer.ts",
    "test:analog-packed-di-consumer": "node --experimental-strip-types tools/server-components/packed-angular-di-consumer.ts",
    "test:full-stack-cloudflare-concurrency": "node --experimental-strip-types tools/server-components/cloudflare-concurrency.ts",
    "test:full-stack-deployed-cloudflare": "node --experimental-strip-types tools/server-components/full-stack-deployed-cloudflare.ts",
    "test:server-component-deployment-skew": "node --experimental-strip-types tools/server-components/deployment-skew.ts",
    "test:server-component-optimized-deps": "node --experimental-strip-types tools/server-components/optimized-deps.ts",
    "test:server-component-package-consumer": "node --experimental-strip-types tools/server-components/package-consumer.ts",
    "test:server-component-registry-consumer": "node --experimental-strip-types tools/server-components/registry-consumer.ts",
    "test:server-components:cloudflare": "node --experimental-strip-types tools/server-components/cloudflare.ts",
    "test:server-components:deployed-cloudflare": "node --experimental-strip-types tools/server-components/deployed-cloudflare.ts",
    "test:www:server-components": "node --experimental-strip-types tools/server-components/www.ts",
    "test:relay:server-components": "node --experimental-strip-types tools/server-components/relay.ts",
    "test:package-consumer": "node --experimental-strip-types tools/package-consumer/run.ts",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf .turbo",
    "changeset": "changeset",
    "release:packages": "node --experimental-strip-types tools/release/publish-packages.ts",
    "release:packages:dry-run": "node --experimental-strip-types tools/release/publish-packages.ts --dry-run",
    "release:sync-dist-tags": "node --experimental-strip-types tools/release/sync-dist-tags.ts",
    "release:sync-dist-tags:dry-run": "node --experimental-strip-types tools/release/sync-dist-tags.ts --dry-run"
  },
  "devDependencies": {
    "@agentyx/cli": "^0.22.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-promise": "7.3.0",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.5"
  }
}
