{
  "name": "strata",
  "private": true,
  "version": "0.0.0",
  "description": "Server Components and structured server APIs for Angular and Analog.",
  "homepage": "https://strata-www.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/Strata.git"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/Strata/issues"
  },
  "keywords": [
    "angular",
    "analogjs",
    "h3",
    "nitro",
    "server-components",
    "typescript",
    "server-framework"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "www:dev": "pnpm --filter @strata-sc/www dev",
    "www:build": "pnpm --filter @strata-sc/www build",
    "www:build:cloudflare": "pnpm --filter @strata-sc/www build:cloudflare",
    "www:pages:dev": "pnpm --filter @strata-sc/www preview:cloudflare",
    "www:pages:create": "pnpm --filter @strata-sc/www pages:create",
    "www:pages:deploy": "pnpm --filter @strata-sc/www deploy:cloudflare",
    "www:test": "pnpm --filter @strata-sc/www test",
    "www:test:e2e": "pnpm --filter @strata-sc/www test:e2e",
    "relay:dev": "pnpm --filter @strata-sc/relay dev",
    "relay:build": "pnpm --filter @strata-sc/relay build",
    "relay:test": "pnpm --filter @strata-sc/relay test",
    "relay:test:e2e": "pnpm --filter @strata-sc/relay test:e2e",
    "relay:verify:server-components": "pnpm --filter @strata-sc/relay verify:server-components",
    "test": "turbo run test",
    "test:consumer": "node --experimental-strip-types tools/consumer/run.ts",
    "test:consumer:types": "node --experimental-strip-types tools/consumer/type-closure/run.ts",
    "test:analog": "node --experimental-strip-types tools/analog/run.ts",
    "test:server-components": "node --experimental-strip-types tools/server-components/run.ts",
    "test:server-component-navigation": "node --experimental-strip-types tools/server-components/navigation.ts",
    "test:server-components:cloudflare": "node --experimental-strip-types tools/server-components/cloudflare.ts",
    "test:www:server-components": "node --experimental-strip-types tools/server-components/www.ts",
    "test:package-consumer": "node --experimental-strip-types tools/package-consumer/run.ts",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf .turbo",
    "changeset": "changeset",
    "release:packages": "node --experimental-strip-types tools/release/publish-packages.ts",
    "release:packages:dry-run": "node --experimental-strip-types tools/release/publish-packages.ts --dry-run"
  },
  "devDependencies": {
    "@agentyx/cli": "^0.7.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-promise": "7.3.0",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "playwright": "1.62.1",
    "prettier": "3.9.7",
    "turbo": "2.10.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-dts": "5.1.0",
    "vitest": "5.0.1"
  }
}
