{
  "name": "@strata-sc/server-components",
  "version": "0.0.0",
  "description": "Experimental Server Components for Angular and Analog with explicit client boundaries and server-only graph isolation.",
  "type": "module",
  "license": "MIT",
  "author": "Andersseen",
  "homepage": "https://github.com/Andersseen/strata#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/strata.git",
    "directory": "packages/server-components"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/strata/issues"
  },
  "keywords": [
    "angular",
    "analogjs",
    "server-components",
    "ssr",
    "hydration",
    "vite",
    "server",
    "typescript"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/fesm2022/index.d.ts",
      "default": "./dist/fesm2022/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite.js"
    },
    "./server-only": {
      "types": "./dist/server-only/index.d.ts",
      "default": "./dist/server-only.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && ngc -p tsconfig.runtime.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "typescript": "^5.9.0 || ^6.0.0",
    "vite": ">=8.3.0 <9"
  },
  "devDependencies": {
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0"
  }
}
