{
  "name": "@strata/analog",
  "version": "0.1.0",
  "description": "Experimental Analog adapter for @strata/core — registers Strata controllers on the Nitro 2 router that Analog runs on.",
  "type": "module",
  "license": "MIT",
  "author": "Andersseen",
  "homepage": "https://github.com/Andersseen/strata#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/strata.git",
    "directory": "packages/analog"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/strata/issues"
  },
  "keywords": [
    "strata",
    "typescript",
    "server",
    "analogjs",
    "nitro",
    "angular",
    "backend",
    "framework"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@strata/core": "workspace:*"
  },
  "devDependencies": {
    "h3": "^1.15.11"
  }
}
