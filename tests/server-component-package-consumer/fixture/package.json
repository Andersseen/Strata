{
  "name": "strata-server-component-package-consumer",
  "version": "0.0.0",
  "private": true,
  "description": "External consumer of the PACKED @strata-sc/server-components tarball. Copied to an OS temp directory outside the Strata workspace and installed with npm by tools/server-components/package-consumer.ts; never part of pnpm-workspace.yaml.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudflare": "BUILD_PRESET=cloudflare-pages vite build",
    "start": "node dist/analog/server/index.mjs",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@analogjs/router": "2.7.2",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/platform-server": "22.1.7",
    "@angular/router": "22.1.7",
    "@strata-sc/server-components": "REPLACED_BY_RUNNER",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/platform": "2.7.2",
    "@analogjs/vite-plugin-angular": "2.7.2",
    "@angular/build": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@types/node": "22.20.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  }
}
