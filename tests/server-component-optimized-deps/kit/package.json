{
  "name": "@acme/server-kit",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "./effect.js"
  ],
  "exports": {
    ".": "./index.js",
    "./format": "./format.js",
    "./secret": "./secret.js",
    "./barrel": "./barrel.js",
    "./safe-barrel": "./safe-barrel.js",
    "./chain": "./chain.js",
    "./types": {
      "types": "./types.d.ts",
      "default": "./types.js"
    },
    "./lazy": "./lazy.js",
    "./cond": {
      "browser": "./cond.browser.js",
      "node": "./cond.node.js",
      "default": "./cond.browser.js"
    },
    "./named-barrel": "./named-barrel.js",
    "./namespace-barrel": "./namespace-barrel.js",
    "./cycle-safe": "./cycle-safe-a.js",
    "./cycle-secret": "./cycle-secret-a.js",
    "./subpath-import": "./subpath-import.js",
    "./cond-barrel": {
      "browser": "./cond.browser.js",
      "node": "./cond-barrel.node.js",
      "default": "./cond.browser.js"
    },
    "./inline-types": "./inline-types.ts",
    "./effect": "./effect.js",
    "./foreign": "./foreign.js",
    "./legacy": "./legacy.cjs",
    "./package.json": "./package.json",
    "./broken": "./broken.js"
  },
  "files": [
