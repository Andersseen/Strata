{
  "name": "strata-full-stack-package-consumer",
  "version": "0.0.0",
  "private": true,
  "description": "External full-stack consumer of the PACKED @strata-sc/core, @strata-sc/analog and @strata-sc/server-components tarballs. Copied to an OS temp directory outside the Strata workspace and installed with npm by tools/server-components/full-stack-consumer.ts; never part of pnpm-workspace.yaml.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudflare": "BUILD_PRESET=cloudflare-pages vite build",
    "start": "node dist/analog/server/index.mjs",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.check.server.json"
  },
  "dependencies": {
    "@analogjs/router": "2.7.2",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@strata-sc/analog": "REPLACED_BY_RUNNER",
    "@strata-sc/core": "REPLACED_BY_RUNNER",
    "@strata-sc/server-components": "REPLACED_BY_RUNNER",
    "h3": "1.15.11",
    "rxjs": "7.8.2",
    "zod": "4.6.5",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/platform": "2.7.2",
    "@analogjs/vite-plugin-angular": "2.7.2",
    "@angular/build": "22.1.8",
    "@angular/compiler-cli": "22.2.3",
    "@types/node": "22.20.3",
    "nitropack": "2.13.4",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.0.18",
    "wrangler": "4.135.0"
  }
}
